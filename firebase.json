{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "functions/**",
            "package.json",
            "package-lock.json",
            "generate-sitemap.js"
        ],
        "rewrites": [
            {
                "source": "/Coches/detalle.html",
                "function": "renderSocialTags"
            },
            {
                "source": "/sitemap.xml",
                "function": "renderSocialTags"
            }
        ],
        "headers": [
            {
                "source": "/Coches/detalle-app.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=300, s-maxage=300"
                    },
                    {
                        "key": "X-Robots-Tag",
                        "value": "index, follow"
                    }
                ]
            },
            {
                "source": "/robots.txt",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            },
            {
                "source": "/assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    },
                    {
                        "key": "X-Robots-Tag",
                        "value": "noindex"
                    }
                ]
            },
            {
                "source": "/assets/logo con fondo.png",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    },
                    {
                        "key": "X-Robots-Tag",
                        "value": "index"
                    }
                ]
            }
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ]
}